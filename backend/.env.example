# Copy to `.env` and fill in as needed. `.env` is gitignored.
# All fields are optional — sane defaults work out of the box (console email,
# permissive CORS, checkpoint auto-detected under app/ml/checkpoints/).

# --- CORS ---
# True (default) allows any origin — fine for local dev. Set to False and list
# your frontend URL(s) for anything beyond a laptop demo.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# --- Uploads ---
MAX_UPLOAD_MB=100

# --- Logging ---
LOG_LEVEL=INFO

# --- Email (patient report) ---
# Default "console" backend: nothing is sent, the HTML is printed to the
# terminal running uvicorn. Set EMAIL_BACKEND=smtp + the fields below for
# real delivery. Google/Workspace: use an App Password, not your login password.
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=brAIn <you@example.com>
